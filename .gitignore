# Local environment -----------------------------------------------------------
# Created from .env-sample on first start; holds local credentials.
.env
.env.*
!.env-sample

# Postgres dumps written by scripts/backup.sh
backups/

# Docker / Compose -------------------------------------------------------------
docker/**/data/
docker-compose.override.yaml
docker-compose.override.yml
compose.override.yaml
compose.override.yml

# Go ---------------------------------------------------------------------------
# Compiled binaries produced by `go build` under cli/.
cli/**/bin/
cli/**/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum
vendor/
coverage.out
coverage.html

# Shell / editors --------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
*~
.direnv/
.vscode/
.idea/
*.swp
*.swo

# OS junk ----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
